# Configuración por defecto: observación y estimación (sin enviar transacciones).
CHAIN=base
# Base mainnet: USDC (6 decimales) -> WETH
QUOTE_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
TARGET_TOKEN=0x4200000000000000000000000000000000000006
AMOUNT_IN=1000000
MIN_PROFIT_QUOTE=0
ESTIMATED_COST_QUOTE=0
INTERVAL_SECONDS=2
MAX_CONCURRENT_QUOTES=12
DATABASE_PATH=data/trades.sqlite3

# Base / 0x. Solicita la clave en el panel oficial de 0x.
ZEROX_API_KEY=
# Base / Odos, agregador para comparación cross-venue en modo paper.
# Base / Aerodrome usa getAmountsOut en el Router oficial y necesita un RPC Base.
RPC_URL=https://mainnet.base.org
ODOS_ROUTER_ADDRESS=

# Solana / Jupiter quote API (filtro de DEX para Orca, Meteora, Pump.fun y LaunchLab).
JUPITER_QUOTE_URL=https://api.jup.ag/swap/v1/quote
JUPITER_API_KEY=
RAYDIUM_QUOTE_URL=https://transaction-v1.raydium.io/compute/swap-base-in

# Tolerancia de slippage enviada al endpoint de cotización de Odos (bps; 50 = 0,5 %).
SLIPPAGE_BPS=50

# Live: requiere además python -m bot --live. Límites expresados en unidades mínimas quote.
LIVE_TRADING=false
EVM_PRIVATE_KEY=
SOLANA_KEYPAIR_PATH=
MAX_TRADE_AMOUNT=0
MAX_DAILY_LOSS=0
MAX_TRADES_PER_HOUR=1000
MAX_GAS_PRICE_GWEI=5
MAX_PRIORITY_FEE_LAMPORTS=1000000

# Histórico de cotizaciones para métricas descriptivas.
METRICS_WINDOW=100
METRICS_MIN_SAMPLES=30
MIN_WIN_PROBABILITY=0.65

# Laya opcional: el modelo sólo puede vetar; no puede habilitar una operación.
LAYA_ENABLED=false
LAYA_BASE_URL=http://cos-alicante.netbird.vpn:8010
LAYA_API_KEY=
LAYA_BLOCK_PROBABILITY=0.70

# Evita que el repositorio de trabajo contenga secretos reales.
